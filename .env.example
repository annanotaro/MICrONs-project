CAVE_TOKEN=your_cave_api_token_here

# Path to the HuggingFace MICrONS snapshot directory (should contain reader.py and microns.h5)
MICRONS_SNAPSHOT_DIR=/absolute/path/to/huggingface/microns-snapshot

# Path to dataset reader
MICRONS_READER_PATH=/absolute/path/to/huggingface/microns-snapshot/reader.py

# Path to the raw dataset HDF5 file
MICRONS_DATA_PATH=/absolute/path/to/huggingface/microns-snapshot/microns.h5